        "jsonBody": "={{ JSON.stringify({ question: $json.body.question, conversation_id: $json.body.conversation_id }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 20],
      "id": "a1f0c2d4-3333-4a0b-9c31-000000000003",
      "name": "Ask the retrieval service"
