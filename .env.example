# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lumen_spa

# Held constant across all runs - see CLAUDE.md
GENERATION_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-opus-5

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

TOP_K=3
CANDIDATE_K=20
SCORE_THRESHOLD=

# Phase 5 demo only. Shared secret for src/service.py, sent by the n8n
# workflow in the X-Service-Secret header. The cloudflared tunnel URL is
# public, so the service refuses to start serving without this set.
# Set the same value in the n8n instance's environment.
RAG_SERVICE_SECRET=
